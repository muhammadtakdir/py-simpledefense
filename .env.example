# ==============================================================================
# py-simpledefense - Konfigurasi Environment
# Salin berkas ini menjadi .env (atau /etc/py-simpledefense/config.env)
# ==============================================================================

# Identitas server yang ditampilkan pada notifikasi Telegram
SERVER_LABEL=app.example.com
SERVER_PUBLIC_IP=203.0.113.10
TIMEZONE_LABEL=WITA

# Kredensial Bot Telegram (buat melalui @BotFather)
TELEGRAM_BOT_TOKEN=1234567890:AAExampleBotTokenReplaceMe

# Daftar tujuan alert Telegram (pisahkan dengan koma: grup/channel atau Chat ID)
TELEGRAM_CHAT_IDS=@nama_channel_csirt,123456789

# Daftar berkas access log Apache / Nginx yang dipantau secara real-time (pisahkan dengan koma)
LOG_FILES=/var/log/apache2/access.log,/var/log/apache2/other_vhosts_access.log

# Daftar IP tepercaya yang dikecualikan dari alert & pemblokiran (pisahkan dengan koma)
WHITELIST_IPS=127.0.0.1,::1

# Jeda minimum pengiriman alert untuk IP yang sama (detik) agar tidak spam
ALERT_COOLDOWN_SECONDS=300

# Opsional: Blokir IP otomatis di level firewall (iptables) jika melampaui ambang batas
# Secara bawaan bernilai false karena Apache WAF sudah menolak request dengan 403 Forbidden
AUTO_BAN_ENABLED=false
AUTO_BAN_THRESHOLD=10
AUTO_BAN_WINDOW_SECONDS=120
